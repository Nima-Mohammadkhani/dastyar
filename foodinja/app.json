{
  "expo": {
    "name": "foodinja",
    "slug": "foodinja",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/appIcon.png",
    "scheme": "foodinja",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/logo/appIcon.png"
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo/appIcon.png",
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/logo/appIcon.png",
      "bundler": "metro"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
